# Copy to .env in the repo root on the EC2 host and fill in. Never commit it.

# ─── Hosting ──────────────────────────────────────────────
API_DOMAIN=api.yourdomain.com           # Caddy gets the TLS cert for this
PORTAL_BASE_URL=https://yourdomain.com  # the Vercel site; used in WhatsApp messages
CORS_ALLOW_ORIGINS=https://yourdomain.com
DEBUG=false

# ─── Database (AWS RDS) ───────────────────────────────────
DATABASE_URL=postgresql+psycopg://carib:<password>@<rds-endpoint>:5432/caribvoices?sslmode=require

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=                             # openssl rand -hex 32 — MUST differ from dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REVIEWER_EMAILS=
ADMIN_EMAILS=

# ─── WhatsApp Cloud API ───────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=                  # any random string; enter the same in Meta
WHATSAPP_APP_SECRET=
AGENT_WHATSAPP_NUMBER=                  # digits only, no '+'

# ─── Storage / ASR ────────────────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET=carib-voices-voicenotes
# Leave the keys empty on EC2: boto3 uses the instance's IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RUNPOD_ASR_ENDPOINT=
RUNPOD_API_KEY=

# ─── Email (Resend) ───────────────────────────────────────
# notifications.jaia.org.jm must be verified in Resend (Domains → DNS records).
RESEND_API_KEY=
EMAIL_FROM=Carib Voices <noreply@notifications.jaia.org.jm>
